{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shelf",
  "version": "0.3.0",
  "identifier": "app.shelf.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shelf",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
